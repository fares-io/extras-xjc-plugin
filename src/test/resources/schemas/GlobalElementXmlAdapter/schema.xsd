<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema
  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
  xmlns:t="urn:globalelement.test"
  targetNamespace="urn:globalelement.test"
  xmlns:jaxb="https://jakarta.ee/xml/ns/jaxb"
  xmlns:extras="urn:jaxb.fares.io:extras"
  jaxb:version="3.0"
  jaxb:extensionBindingPrefixes="extras">
  <xsd:element name="Price" type="t:MoneyAmount">
    <xsd:annotation>
      <xsd:appinfo>
        <extras:xml-adapter name="test.complextypeadapter.AmountXmlAdapter"/>
      </xsd:appinfo>
    </xsd:annotation>
  </xsd:element>
  <xsd:complexType name="MoneyAmount">
    <xsd:simpleContent>
      <xsd:extension base="xsd:decimal">
        <xsd:attribute name="currency" type="xsd:string" use="required"/>
      </xsd:extension>
    </xsd:simpleContent>
  </xsd:complexType>
</xsd:schema>
