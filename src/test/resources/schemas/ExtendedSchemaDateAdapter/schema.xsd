<xsd:schema targetNamespace="urn:extendedschemadateadapter.test"
            xmlns:tns="urn:extendedschemadateadapter.test"
            xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            xmlns:jaxb="https://jakarta.ee/xml/ns/jaxb"
            xmlns:extras="urn:jaxb.fares.io:extras"
            elementFormDefault="qualified"
            jaxb:version="3.0"
            jaxb:extensionBindingPrefixes="extras">

  <xsd:annotation>
    <xsd:appinfo>
      <jaxb:globalBindings fixedAttributeAsConstantProperty="true"/>
    </xsd:appinfo>
  </xsd:annotation>

  <xsd:complexType name="Book">
        <xsd:sequence>
          <xsd:element name="dateOriginalPublished" type="xsd:date" />
          <xsd:element name="dateLastPublished" type="tns:PublisherDate">
            <xsd:annotation>
              <xsd:appinfo>
                <extras:xml-adapter name="test.extendedschemadateadapter.PublisherDateAdapter"/>
              </xsd:appinfo>
            </xsd:annotation>
          </xsd:element>
        </xsd:sequence>
  </xsd:complexType>

  <xsd:simpleType name="PublisherDate">
    <xsd:restriction base="xsd:date"/>
  </xsd:simpleType>

</xsd:schema>
