<xsd:schema targetNamespace="urn:multimodel.test" xmlns:tns="urn:multimodel.test" xmlns:xsd="http://www.w3.org/2001/XMLSchema"
  xmlns:jaxb="https://jakarta.ee/xml/ns/jaxb" xmlns:extras="urn:jaxb.fares.io:extras" elementFormDefault="qualified" jaxb:version="3.0"
  jaxb:extensionBindingPrefixes="extras">

  <xsd:annotation>
    <xsd:appinfo>
      <jaxb:globalBindings fixedAttributeAsConstantProperty="true"/>
    </xsd:appinfo>
  </xsd:annotation>

  <xsd:complexType name="Book">
    <xsd:sequence>
      <xsd:element name="isbn" type="xsd:string" minOccurs="0"/>
      <xsd:element name="title" type="xsd:string"/>
      <xsd:element name="author" type="xsd:string"/>
    </xsd:sequence>
    <xsd:attributeGroup ref="tns:identifiers"/>
  </xsd:complexType>


  <xsd:complexType name="Cassette">
    <xsd:sequence>
      <xsd:element name="play" type="xsd:string"/>
    </xsd:sequence>
    <xsd:attributeGroup ref="tns:identifiers"/>
  </xsd:complexType>
  <xsd:attributeGroup name="identifiers">
    <xsd:attribute name="id" type="xsd:string" use="required"/>
    <xsd:attribute name="language" type="tns:languages"/>
  </xsd:attributeGroup>
  <xsd:simpleType name="languages">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="English"/>
      <xsd:enumeration value="Italian"/>
      <xsd:enumeration value="Japanese"/>
    </xsd:restriction>
  </xsd:simpleType>
</xsd:schema>
