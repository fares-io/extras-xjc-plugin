<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema
  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
  xmlns:t="urn:moneyguards.test"
  targetNamespace="urn:moneyguards.test"
  xmlns:jaxb="https://jakarta.ee/xml/ns/jaxb"
  xmlns:extras="urn:jaxb.fares.io:extras"
  jaxb:version="3.0"
  jaxb:extensionBindingPrefixes="extras">
  <xsd:complexType name="Book">
    <xsd:sequence>
      <xsd:element name="price" type="t:MoneyAmount">
        <xsd:annotation>
          <xsd:appinfo>
            <extras:java-money-adapter currencyProperty="currency" valueProperty="value"/>
          </xsd:appinfo>
        </xsd:annotation>
      </xsd:element>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="MoneyAmount">
    <xsd:simpleContent>
      <xsd:extension base="xsd:decimal">
        <xsd:attribute name="currency" type="xsd:string" use="optional"/>
      </xsd:extension>
    </xsd:simpleContent>
  </xsd:complexType>
</xsd:schema>
